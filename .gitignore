# Terraform state
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform lock and cache
**/.terraform/
.terraform.lock.hcl

# Variable files with real values
terraform.tfvars
*.auto.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan files (may contain secrets)
*.tfplan

# macOS
.DS_Store

# Editor
*.swp
*.swo

# Environment files
.env
.env.*
.envrc

